DATABASE_URL=postgres://postgres:postgres@localhost:5432/the_push
PAYLOAD_SECRET=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
RESEND_API_KEY=
RESEND_FROM_EMAIL=The Push <no-reply@itayfoyerstein.com>
RESEND_REPLY_TO=hello@itayfoyerstein.com
FIT_CALL_LEADS_TO=hello@itayfoyerstein.com
# Approved post-diagnostic booking target. Diagnostic V3 reads this in
# bookingUrl() and returns it only when the value is an https URL.
# The diagnostic card shows duration only and must not display a price.
# Set the same URL on Vercel Preview. Do not change Production env from this example.
DIAGNOSTIC_V3_BOOKING_URL=https://cal.com/itayfoyer/leadership-diagnostic-75-minutes
# Fast question UX. Unset, or any value other than false, keeps it on.
# Set to false to restore blocking saves and no auto-advance. Read per request.
DIAGNOSTIC_V3_FAST_UX=true
# Public duration on the conversation booking card. Unset defaults to 75.
# Set to empty or off to hide the card. Do not add a public price for this card.
DIAGNOSTIC_V3_BOOKING_DURATION_MIN=75
